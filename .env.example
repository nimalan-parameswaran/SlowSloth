# SlowSloth Configuration
# Default: Localhost binding only for security
SLOWSLOTH_HOST=127.0.0.1
SLOWSLOTH_PORT=8000
SLOWSLOTH_DB_PATH=data/slowsloth.db
SLOWSLOTH_TIMEZONE=Asia/Kolkata

# AI Inference Backend Settings
# Options: dev_mock | llama_cpp | ollama
AI_BACKEND=dev_mock
AI_MODEL_IDENTIFIER=deterministic-rule-parser
INFERENCE_ENDPOINT=http://127.0.0.1:8080
INFERENCE_TIMEOUT_SEC=45
CONTEXT_LIMIT=2048
ALLOW_DEV_FALLBACK=true

# Security & LAN Configuration
# Set to true only on trusted local networks after reviewing access controls
ENABLE_LAN_ACCESS=false
# Optional LAN API key header (X-SlowSloth-Key) for LAN access authentication
LAN_API_KEY=
